#!/bin/sh
# Pre-commit gate. Runs the same checks the Evaluator Rubric in CLAUDE.md
# lists, so a commit can only land if every mechanical gate passes.
#
# Enabled per-clone via `git config core.hooksPath .githooks` (the npm
# `prepare` script does this automatically on `npm install`).
#
# Gates run sequentially; the first failure aborts.
#   1. npm run build  — vitest + tsc + vite (covers Evaluator Gates 1, 3, 4, 5)
#   2. npm run lint   — gts / ESLint (Gate 2 + Gate 6 complexity rules)
#   3. npm run check:dead — knip (Gate 7 dead-code detection)
#
# Skipped entirely when no source/config files are staged — pure doc /
# .archive / docs/ edits don't pay the ~6s cost.

CHANGED_RE='^(src/|test/|scripts/|vite\.config\.ts|vitest\.config\.ts|playwright\.config\.ts|tsconfig\.json|package\.json|package-lock\.json|eslint\.config\.js|knip\.json)'

if ! git diff --cached --name-only | grep -qE "$CHANGED_RE"; then
  exit 0
fi

echo "🔍 Source/config files changed — running pre-commit gates..."

echo "📦 build (vitest + tsc + vite)..."
if ! npm run build; then
  echo "❌ Build failed. Commit aborted."
  exit 1
fi

echo "🧹 lint (gts / ESLint)..."
if ! npm run lint; then
  echo "❌ Lint failed. Commit aborted."
  exit 1
fi

echo "💀 dead-code check (knip)..."
if ! npm run check:dead; then
  echo "❌ Dead-code check failed. Commit aborted."
  exit 1
fi

echo "✅ All gates passed."
