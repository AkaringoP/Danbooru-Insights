# OS junk files
*.DS_Store
Thumbs.db
Desktop.ini

# IDE config
.vscode/
.idea/

# Node/Build output
node_modules/
dist/
build/
npm-debug.log
yarn-error.log

# Temporary files
*.tmp
*.bak
*.swp

# Claude (tool config, not source code)
# Note: CLAUDE.md and .claude/rules/ are intentionally tracked — they're the
# project's instruction files for Claude Code sessions and benefit from being
# available on mobile / other machines via GitHub. CLAUDE.ko.md and
# .claude/settings.local.json stay local (user-specific config).
CLAUDE.ko.md
.claude/*
!.claude/rules/

# Claude session files (generated during AI-assisted work sessions)
PLAN.md
TASK.md
context.md
checklist.md

# Task archive (local-only translated TASK.md snapshots)
.archive/

# Local build-comparison artifact (manually-saved alternate-branch userscript
# for side-by-side perf measurement; not source, not produced by the build).
danbooruinsights-main.user.js

# Local benchmark workspace — saved baseline userscripts, captured DevTools
# console logs from manual A/B runs, and generated comparison reports.
# Created during Phase 0 of feature/db-strategy-upgrade. See PLAN.md
# "성능 비교 전략" and TASK.md Tasks 0.2 ~ 4.2.
bench/

# Playwright runtime output (not snapshots — those live in test/e2e/snapshots/
# and are committed). test-results/ holds per-run traces/videos/screenshots;
# playwright-report/ is the HTML reporter output.
test-results/
playwright-report/
